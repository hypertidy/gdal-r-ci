# ghcr.io/hypertidy/gdal-r:latest  /  :dev
#
# Adds R (from CRAN Ubuntu repo) on top of gdal-r-base.
# Installs a minimal set of packages needed for package development and testing.
# All R packages built from source — no pak/r2u/RSPM binaries that might
# have been compiled against a different GDAL.

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-system:latest
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="R + dev tooling on clean GDAL/PROJ/GEOS base"

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Extra apt deps that R packages need at build time
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # R install infrastructure
    dirmngr gnupg \
    # R package build-time needs
    libcurl4-openssl-dev libssl-dev libxml2-dev \
    libfontconfig1-dev libfreetype6-dev \
    libharfbuzz-dev libfribidi-dev \
    libpng-dev libjpeg-dev \
    libudunits2-dev \
    libabsl-dev \
    # for fs package
    libuv1-dev \
    # Docs/check tools
    pandoc qpdf \
    # provides checkbashisms
    devscripts \
    # for --as-cran PDF manual check
    texinfo \
    # locale-gen
    locales \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*


# Install R from CRAN Ubuntu repository (current R release)
RUN wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
    | tee /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc \
    && echo "deb https://cloud.r-project.org/bin/linux/ubuntu \
$(lsb_release -cs)-cran40/" > /etc/apt/sources.list.d/cran.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends r-base r-base-dev \
    && rm -rf /var/lib/apt/lists/*

# Source packages only: R packages must compile against our GDAL/PROJ/GEOS.
# Never let pak or install.packages pull a CRAN binary built against Ubuntu's GDAL.
RUN echo 'options(repos = c(CRAN = "https://cloud.r-project.org"))' >> /etc/R/Rprofile.site \
    && echo 'options(pkgType = "source")' >> /etc/R/Rprofile.site \
    && echo 'options(Ncpus = parallel::detectCores())' >> /etc/R/Rprofile.site

# Tell R where our libraries live
RUN echo '/usr/local/lib' >> /etc/ld.so.conf.d/gdal-r-local.conf && ldconfig

COPY config/r-packages-base.txt /tmp/r-packages-base.txt
RUN Rscript -e "pkgs <- readLines('/tmp/r-packages-base.txt'); pkgs <- pkgs[!grepl('^#', pkgs) & nchar(trimws(pkgs)) > 0]; install.packages(pkgs, type = 'source', Ncpus = parallel::detectCores())"

RUN R -e "tinytex::install_tinytex(bundle = 'TinyTeX-1', force = TRUE)"

# The installer appends ~/.TinyTeX/bin/<arch> to PATH via a shell profile
# edit, which doesn't apply to non-login shells in Docker RUN layers.
# Make it explicit:
ENV PATH="/root/.TinyTeX/bin/x86_64-linux:${PATH}"

RUN R -e "tinytex::tlmgr_install(c('inconsolata','upquote','courier','helvetic','hyperref','titling','framed','grfext'))"

# Quick sanity check: R finds our GDAL headers
RUN Rscript -e "cat('R', R.version\$major, R.version\$minor, '\n')" \
    && echo "gdal-config: $(gdal-config --version)" \
    && echo "PROJ: $(pkg-config --modversion proj)" \
    && echo "GEOS: $(geos-config --version)"

WORKDIR /workspace
CMD ["R"]
