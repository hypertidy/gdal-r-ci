# syntax=docker/dockerfile:1.7
# ghcr.io/hypertidy/gdal-r-mesh:latest
#
# Mesh layer on top of gdal-r-full: wk with simple features surface types
# (TIN, TRIANGLE, POLYHEDRALSURFACE), wkpool with its TIN round-trip
# article, and the triangulation engines cdtr (CDT), laridae (CGAL) and
# decido (earcut). Package list: config/r-packages-mesh.txt.
#
# Leaf image: only :latest, no :dev variant. Several entries are
# development branches, so this image tracks work in progress; pin a digest
# if you need it fixed.

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-r-full:latest
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="gdal-r-full + mesh stack: wk (surface types), wkpool, cdtr, laridae, decido"
LABEL org.opencontainers.image.documentation="https://github.com/hypertidy/gdal-r-ci#gdal-r-mesh"

COPY scripts/install-mesh.R      /opt/scripts/install-mesh.R
COPY scripts/smoke-mesh.R        /opt/scripts/smoke-mesh.R
COPY scripts/strip-r-libs.sh     /opt/scripts/strip-r-libs.sh
COPY config/r-packages-mesh.txt  /tmp/r-packages-mesh.txt

# laridae compiles CGAL (via RcppCGAL headers); that is most of this layer's
# build time. GITHUB_PAT is passed as a secret so remotes is not rate limited.
RUN --mount=type=secret,id=github_pat,required=false \
    if [ -s /run/secrets/github_pat ]; then export GITHUB_PAT="$(cat /run/secrets/github_pat)"; fi \
 && touch /tmp/r-stamp \
 && Rscript /opt/scripts/install-mesh.R \
 && bash /opt/scripts/strip-r-libs.sh /tmp/r-stamp

RUN Rscript /opt/scripts/smoke-mesh.R

RUN { \
        echo "-- ghcr.io/hypertidy/gdal-r-mesh --" ; \
        echo "GDAL $(gdal-config --version)   PROJ $(pkg-config --modversion proj)   GEOS $(geos-config --version)" ; \
        echo "R    $(R --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')   (wk surfaces, wkpool, cdtr, laridae, decido)" ; \
        echo "" ; \
        echo "Docs: https://github.com/hypertidy/gdal-r-ci#gdal-r-mesh" ; \
    } > /etc/gdal-r-ci-motd

WORKDIR /workspace
CMD ["bash"]
