# ghcr.io/hypertidy/gdal-system:latest  (release branch)
# ghcr.io/hypertidy/gdal-system:dev     (dev branch)
#
# Builds GEOS, PROJ, and GDAL from source on plain Ubuntu 24.04.
# All three are installed to /usr/local with standard symbols.
# R packages (sf, terra, vapour, gdalraster) link the same libproj/libgdal
# as GDAL itself — one PROJ, no dual-library crashes, full R CMD check works.
#
# Python: a uv-managed venv at /opt/gdal-py exists from this layer onward.
# numpy 2.x is installed into the venv BEFORE GDAL builds, so the GDAL
# Python bindings link against numpy 2.x's ABI from the start. No system
# numpy involved — apt's python3-numpy would be 1.x and would create the
# downstream ABI mismatch we used to fix post-hoc. The venv propagates to
# every downstream layer; gdal-r and gdal-r-full inherit it but don't use
# it (~80 MB cost, accepted for architectural cleanliness).

FROM ubuntu:24.04

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="GDAL/PROJ/GEOS built from source, no internal PROJ"
LABEL org.opencontainers.image.documentation="https://github.com/hypertidy/gdal-r-ci#gdal-system"

ARG GDAL_VERSION=master
ARG GDAL_REPOSITORY=OSGeo/gdal
ARG PROJ_VERSION=master
ARG GEOS_VERSION=main
ARG NCPUS=0

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
ENV LC_ALL=C.UTF-8
ENV LANG=C.UTF-8

## eprtk for  muparser
RUN curl -fsSL https://raw.githubusercontent.com/ArashPartow/exprtk/master/exprtk.hpp \
        -o /usr/local/include/exprtk.hpp


# ── 1. Build-time and runtime apt dependencies ───────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # Toolchain
    build-essential cmake git wget curl ca-certificates pkg-config \
    software-properties-common lsb-release unzip \
    # Python: dev headers and SWIG only — numpy lives in the venv (see below)
    python3-dev swig \
    # PROJ build deps
    libsqlite3-dev sqlite3 libcurl4-openssl-dev libtiff-dev \
    # GDAL build deps — format libraries
    libpng-dev libjpeg-turbo8-dev libgif-dev libwebp-dev \
    libopenjp2-7-dev libdeflate-dev liblzma-dev \
    libblosc-dev libzstd-dev liblz4-dev liblerc-dev \
    libxml2-dev libexpat1-dev \
    # spatialite build deps but no librttopo because that installs geos
    libminizip-dev \
    # GDAL — HDF / NetCDF / scientific formats
    libhdf4-alt-dev libhdf5-dev \
    libnetcdf-dev netcdf-bin \
    # GDAL — vector / database drivers
    libpq-dev libmysqlclient-dev \
    # GDAL — misc drivers
    libkml-dev libxerces-c-dev libpoppler-dev libpoppler-private-dev \
    libcfitsio-dev libfreexl-dev \
    libspdlog-dev \
    # Runtime
    libsqlite3-0 \
    nano \
    libmuparser-dev  \
    && rm -rf /var/lib/apt/lists/*

ARG CACHE_DATE=unknown

# ── 2. Apache Arrow (GeoParquet support) ─────────────────────────────────────
RUN apt-get install -y --no-install-recommends gpg \
    && wget -q https://dist.apache.org/repos/dist/release/arrow/KEYS \
        -O /tmp/arrow-keyring.asc \
    && gpg --dearmor < /tmp/arrow-keyring.asc \
        > /usr/share/keyrings/apache-arrow-keyring.gpg \
    && rm /tmp/arrow-keyring.asc \
    && echo "deb [signed-by=/usr/share/keyrings/apache-arrow-keyring.gpg] https://packages.apache.org/artifactory/arrow/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/apache-arrow.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        libarrow-dev libparquet-dev libarrow-dataset-dev libarrow-acero-dev \
    && rm -rf /var/lib/apt/lists/*

# ── 3. Python venv with numpy 2.x — established BEFORE GDAL builds ──────────
# Install uv from its standalone installer; no apt python3-pip involvement.
RUN wget -qO- https://astral.sh/uv/install.sh | sh \
 && mv /root/.local/bin/uv /usr/local/bin/uv \
 && mv /root/.local/bin/uvx /usr/local/bin/uvx 2>/dev/null || true

# Create the venv that lives at every downstream layer. Use system python3 as
# the base interpreter (we still rely on apt's python3-dev for headers).
RUN uv venv /opt/gdal-py --python python3

# numpy 2.x in the venv. GDAL's bindings build will link against this.
RUN uv pip install --python /opt/gdal-py/bin/python "numpy>=2" setuptools wheel

# Make the venv the default Python for every subsequent step (and for users
# entering the image interactively). No --system-site-packages: the venv is
# self-contained, and downstream layers extend it cleanly.
ENV PATH=/opt/gdal-py/bin:$PATH
ENV VIRTUAL_ENV=/opt/gdal-py


# ── 4. GEOS ───────────────────────────────────────────────────────────────────
COPY build-scripts/build-geos.sh /build-scripts/build-geos.sh
RUN bash /build-scripts/build-geos.sh && ldconfig

# ── 5. PROJ ───────────────────────────────────────────────────────────────────
COPY build-scripts/build-proj.sh /build-scripts/build-proj.sh
RUN bash /build-scripts/build-proj.sh && ldconfig

# ── 6. Spatialite ─────────────────────────────────────────────────────────────
# Built against /usr/local GEOS/PROJ. Apt's libspatialite-dev is removed by
# the script — it linked Ubuntu's libgeos and would conflict at the header level.
COPY build-scripts/build-spatialite.sh /build-scripts/build-spatialite.sh
RUN bash /build-scripts/build-spatialite.sh && ldconfig

# ── 7. KEA ───────────────────────────────────────────────────────────────────
COPY build-scripts/build-kea.sh /build-scripts/build-kea.sh
RUN bash /build-scripts/build-kea.sh && ldconfig

# ── 8. GDAL ───────────────────────────────────────────────────────────────────
# Bindings build uses /opt/gdal-py/bin/python — see build-gdal.sh.
COPY build-scripts/build-gdal.sh /build-scripts/build-gdal.sh
ARG GDAL_VERSION
ARG GDAL_REPOSITORY
RUN bash /build-scripts/build-gdal.sh && ldconfig

# ── 9. Verify ─────────────────────────────────────────────────────────────────
RUN echo "=== Library versions ===" \
    && gdal-config --version \
    && echo "PROJ: $(pkg-config --modversion proj)" \
    && echo "GEOS: $(geos-config --version)" \
    && echo "" \
    && echo "=== numpy + osgeo (one ABI through both) ===" \
    && /opt/gdal-py/bin/python -c "import numpy; print('numpy:', numpy.__version__)" \
    && /opt/gdal-py/bin/python -c "from osgeo import gdal_array; print('gdal_array OK:', gdal_array.__file__)" \
    && echo "" \
    && echo "=== Key GDAL drivers ===" \
    && gdal-config --formats | tr ' ' '\n' | grep -iE 'arrow|parquet|netcdf|hdf|zarr|kea|gpkg' | sort

RUN strip --strip-unneeded /usr/local/lib/lib*.so* 2>/dev/null || true

# ── MOTD ─────────────────────────────────────────────────────────────────────
RUN { \
        echo "── ghcr.io/hypertidy/gdal-system ──" ; \
        echo "GDAL $(gdal-config --version)   PROJ $(pkg-config --modversion proj)   GEOS $(geos-config --version)" ; \
        echo "Py   $(/opt/gdal-py/bin/python -c 'import sys; print(sys.version.split()[0])')   numpy $(/opt/gdal-py/bin/python -c 'import numpy; print(numpy.__version__)')" ; \
        echo "" ; \
        echo "Docs: https://github.com/hypertidy/gdal-r-ci#gdal-system" ; \
    } > /etc/gdal-r-ci-motd \
 && echo '[ -t 0 ] && [ -f /etc/gdal-r-ci-motd ] && cat /etc/gdal-r-ci-motd' \
        >> /etc/bash.bashrc

WORKDIR /workspace
CMD ["bash"]
