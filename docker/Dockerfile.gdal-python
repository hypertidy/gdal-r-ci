# ghcr.io/hypertidy/gdal-python:latest  /  :dev
#
# Adds a uv-managed Python environment at /opt/gdal-py on top of gdal-r-full.
#
# osgeo.gdal comes from the system Python (compiled against our GDAL build
# in gdal-system) via --system-site-packages. No PyPI GDAL package needed,
# no version matching risk, works identically for release and dev branches.
#
# rasterio, fiona, pyproj are built from source (--no-binary) so they
# link against the same /usr/local GDAL/PROJ as everything else.

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-r-full:latest
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="gdal-r-full + Python geo stack in /opt/gdal-py"

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --quiet uv --break-system-packages

# --system-site-packages exposes osgeo (installed by the GDAL build into
# /usr/local/lib/python3.x/dist-packages) without any reinstall.
RUN uv venv /opt/gdal-py --python python3 --system-site-packages

# Verify osgeo is visible through the venv before installing anything else
RUN /opt/gdal-py/bin/python -c "from osgeo import gdal; print('osgeo.gdal:', gdal.__version__)"

# Install geo Python packages from source so they compile against our
# /usr/local GDAL/PROJ/GEOS rather than bundled wheels.
RUN GDAL_CONFIG=/usr/local/bin/gdal-config \
    PROJ_DIR=/usr/local \
    /opt/gdal-py/bin/pip install --no-binary :all: \
        numpy \
        pyproj \
        rasterio \
        fiona \
        shapely \
        geopandas

ENV PATH=/opt/gdal-py/bin:$PATH
ENV VIRTUAL_ENV=/opt/gdal-py

COPY scripts/check-python-versions.py /opt/scripts/check-python-versions.py
RUN python /opt/scripts/check-python-versions.py

CMD ["python"]
