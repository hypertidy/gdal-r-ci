# ghcr.io/hypertidy/gdal-r-full:latest  /  :dev
#
# Installs the core GDAL-dependent R packages on top of gdal-r.
# All packages compiled from source against the same GDAL/PROJ/GEOS.
#
# IMAGE_VARIANT controls failure behaviour:
#   release — SET A (gdalraster) FAILS the build if it fails
#   dev     — SET A failures are logged but build continues; dev canary
#             images are still useful for testing optional packages even
#             if gdalraster fails against bleeding-edge GDAL/GEOS

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-r:latest
FROM ${BASE_IMAGE}

ARG IMAGE_VARIANT=release

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="Core GDAL R packages: gdalraster, sf, terra, vapour, gdalcubes; R arrow on the system Arrow C++"
LABEL org.opencontainers.image.documentation="https://github.com/hypertidy/gdal-r-ci#gdal-r-full"

COPY scripts/check-r-versions.R    /opt/scripts/check-r-versions.R
COPY scripts/install-required.R    /opt/scripts/install-required.R
COPY scripts/install-optional.R    /opt/scripts/install-optional.R
COPY scripts/install-arrow.R       /opt/scripts/install-arrow.R
COPY scripts/strip-r-libs.sh      /opt/scripts/strip-r-libs.sh
COPY config/r-packages-required.txt /tmp/r-packages-required.txt
COPY config/r-packages-optional.txt  /tmp/r-packages-optional.txt

# Record which variant this image is
RUN echo "${IMAGE_VARIANT}" > /opt/image_variant.txt

# -- R arrow, on the system Arrow C++ ------------------------------------------
# Before SET A/B on purpose: arrow doesn't link GDAL, so GitHub-HEAD churn in
# gdalraster, sf and terra below doesn't invalidate this (slow) layer.
# Same Arrow major as gdal-system's apt libarrow; one libarrow per process.
# Downstream CI should use this build (no NOT_CRAN / LIBARROW_BINARY).
RUN touch /tmp/r-stamp && Rscript /opt/scripts/install-arrow.R && bash /opt/scripts/strip-r-libs.sh /tmp/r-stamp

# ── SET A: Required packages ──────────────────────────────────────────────────
# For release: failure is fatal (something is genuinely broken)
# For dev: failure is logged but build continues (canary signal, not a blocker)
RUN touch /tmp/r-stamp \
 && if [ "${IMAGE_VARIANT}" = "release" ]; then \
        Rscript /opt/scripts/install-required.R; \
    else \
        Rscript /opt/scripts/install-required.R \
            || echo "WARNING: required package install failed on dev variant — canary signal"; \
    fi \
 && bash /opt/scripts/strip-r-libs.sh /tmp/r-stamp

# ── SET B: Optional packages ─────────────────────────────────────────────────
RUN touch /tmp/r-stamp && Rscript /opt/scripts/install-optional.R && bash /opt/scripts/strip-r-libs.sh /tmp/r-stamp

# ── Version alignment check ───────────────────────────────────────────────────
# Non-fatal on dev — misalignment may be expected during bleeding-edge transitions
RUN if [ "${IMAGE_VARIANT}" = "release" ]; then \
        Rscript /opt/scripts/check-r-versions.R; \
    else \
        Rscript /opt/scripts/check-r-versions.R \
            || echo "WARNING: version misalignment on dev variant — check logs"; \
    fi

# ── Quarto CLI ───────────────────────────────────────────────────────────────
# Needed by pkgdown (Quarto-format vignettes) and by the R quarto package at
# runtime. We install the CLI here rather than in gdal-r-python-extras so
# that gdal-r-full can serve as a pkgdown/docs build base without Python.
# Version pinned — bump deliberately; check https://github.com/quarto-dev/quarto-cli/releases
ARG QUARTO_VERSION=1.6.42
RUN ARCH=$(dpkg --print-architecture) \
 && case "$ARCH" in \
      amd64) QUARTO_ARCH="linux-amd64" ;; \
      arm64) QUARTO_ARCH="linux-arm64" ;; \
      *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
    esac \
 && curl -fsSL "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-${QUARTO_ARCH}.tar.gz" \
      | tar xz -C /usr/local --strip-components=1 \
 && quarto --version

# ── pak + pkgdown ────────────────────────────────────────────────────────────
# pak is the install driver used downstream; pkgdown is baked here so the
# image can build R package documentation sites without the extras layer.
RUN Rscript -e " \
  install.packages('pak', \
    repos = sprintf('https://r-lib.github.io/p/pak/stable/%s/%s/%s', \
      .Platform\$pkgType, R.Version()\$os, R.Version()\$arch)); \
  pak::pkg_install(c('pkgdown', 'quarto'), ask = FALSE) \
"

# ── MOTD: refreshed for this image (no Python yet — added in gdal-r-python)
RUN { \
        echo "── ghcr.io/hypertidy/gdal-r-full ──" ; \
        echo "GDAL $(gdal-config --version)   PROJ $(pkg-config --modversion proj)   GEOS $(geos-config --version)" ; \
        echo "R    $(R --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')   (sf, terra, gdalraster, vapour, gdalcubes)" ; \
        echo "Arrow $(pkg-config --modversion arrow)   (R arrow on the system libarrow)" ; \
        echo "Quarto $(quarto --version)   pak + pkgdown" ; \
        echo "" ; \
        echo "Docs: https://github.com/hypertidy/gdal-r-ci#gdal-r-full" ; \
    } > /etc/gdal-r-ci-motd

CMD ["bash"]
