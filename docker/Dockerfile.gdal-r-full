# ghcr.io/hypertidy/gdal-r-full:latest  /  :dev
#
# Installs the core GDAL-dependent R packages on top of gdal-r.
# All packages compiled from source against the same GDAL/PROJ/GEOS.
#
# SET A (required): build FAILS if these fail — gdalraster is the test target
# SET B (optional): individual failures are logged but don't stop the build
#
# Version alignment is verified at the end: if GDAL/PROJ/GEOS versions
# disagree between packages the check script exits non-zero and fails the build.

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-r:latest
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="Core GDAL R packages: gdalraster, sf, terra, vapour, gdalcubes"

COPY scripts/check-r-versions.R /opt/scripts/check-r-versions.R
COPY config/r-packages-required.txt /tmp/r-packages-required.txt
COPY config/r-packages-optional.txt  /tmp/r-packages-optional.txt

# ── SET A: Required packages ──────────────────────────────────────────────────
# Use CRAN HEAD (not GitHub) when the package has a CRAN release — lets us test
# against the released source which is what users actually install.
# Use GitHub (owner/repo) for packages where we want latest commits.
RUN Rscript -e "
  pkgs <- readLines('/tmp/r-packages-required.txt')
  pkgs <- pkgs[!grepl('^#', pkgs) & nchar(trimws(pkgs)) > 0]
  for (pkg in pkgs) {
    message(strrep('=', 60))
    message('REQUIRED: ', pkg)
    message(strrep('=', 60))
    if (grepl('/', pkg)) {
      remotes::install_github(pkg, upgrade = 'never', build_vignettes = FALSE)
    } else {
      install.packages(pkg, type = 'source')
    }
  }
"

# ── SET B: Optional packages ─────────────────────────────────────────────────
RUN Rscript -e "
  pkgs <- readLines('/tmp/r-packages-optional.txt')
  pkgs <- pkgs[!grepl('^#', pkgs) & nchar(trimws(pkgs)) > 0]
  results <- list()
  for (pkg in pkgs) {
    message(strrep('=', 60))
    message('OPTIONAL: ', pkg)
    message(strrep('=', 60))
    pkg_name <- sub('.*/','', pkg)
    ok <- tryCatch({
      if (grepl('/', pkg)) {
        remotes::install_github(pkg, upgrade = 'never', build_vignettes = FALSE)
      } else {
        install.packages(pkg, type = 'source')
      }
      requireNamespace(pkg_name, quietly = TRUE)
    }, error = function(e) {
      message('FAILED: ', conditionMessage(e)); FALSE
    })
    results[[pkg_name]] <- ok
  }
  message()
  message(strrep('=', 60))
  message('Optional package summary:')
  for (n in names(results)) {
    message(sprintf('  %-20s [%s]', n, if (results[[n]]) 'OK' else 'FAILED'))
  }
"

# ── Version alignment check ───────────────────────────────────────────────────
# With a single PROJ (no internal-PROJ), all packages should report identical
# GDAL/PROJ/GEOS versions. This check is now strict — no warn_only for PROJ.
RUN Rscript /opt/scripts/check-r-versions.R

CMD ["R"]
