# syntax=docker/dockerfile:1.7
# ghcr.io/hypertidy/gdal-r-python:latest  /  :dev
#
# Adds Python geospatial packages on top of gdal-r-full. The venv at
# /opt/gdal-py was created in gdal-system with numpy 2.x and the GDAL
# Python bindings already built against it — this layer just installs
# packages into it. No --system-site-packages, no post-hoc rebuilds.
#
# --no-binary policy:
#   MUST build from source (link system GDAL/PROJ/GEOS/Arrow):
#     rasterio, fiona, pyogrio, shapely, pyproj, geopandas, odc-geo, rioxarray,
#     pyarrow (links the apt libarrow/libparquet that GDAL's Parquet driver
#     already loads; a wheel would put a second Arrow C++ in the process.
#     pyarrow major version MUST equal the Arrow C++ major version.)
#   WHEELS fine (pure Python, Cython, or safely bundled):
#     pandas, xarray, zarr, fsspec, netCDF4, h5py/h5netcdf, scipy,
#     matplotlib, dask, polars, duckdb, fastparquet
#     (polars, duckdb, sedonadb carry their own Arrow implementations, not
#     libarrow, so they do not conflict.)
#   NOTE: netCDF4 and h5py bundle their own HDF5 — do NOT use --no-binary,
#   it will fight with system HDF5.
#
# CACHE: BuildKit cache mount on /root/.cache/uv keeps wheels out of image
# layers entirely. UV_LINK_MODE=copy because the cache mount lives on a
# different filesystem than the venv (uv would otherwise try to hardlink
# across mounts and fail).

ARG BASE_IMAGE=ghcr.io/hypertidy/gdal-r-full:latest
FROM ${BASE_IMAGE}

ARG IMAGE_VARIANT=release

# pyarrow must match the Arrow C++ major version installed in gdal-system.
RUN echo "pyarrow==$(pkg-config --modversion arrow | cut -d. -f1).*" \
        > /opt/pyarrow-constraint.txt \
 && cat /opt/pyarrow-constraint.txt


LABEL org.opencontainers.image.source="https://github.com/hypertidy/gdal-r-ci"
LABEL org.opencontainers.image.description="gdal-r-full + Python geo stack in /opt/gdal-py"
LABEL org.opencontainers.image.documentation="https://github.com/hypertidy/gdal-r-ci#gdal-r-python"

ENV UV_LINK_MODE=copy
ENV PYTHONDONTWRITEBYTECODE=1

# Sanity: the inherited venv works and osgeo/numpy are aligned. Cheap check
# that catches a broken inheritance chain immediately.
RUN <<'EOF' /opt/gdal-py/bin/python
import numpy
from osgeo import gdal, gdal_array
print(f'numpy:      {numpy.__version__}')
print(f'gdal:       {gdal.__version__}')
print(f'gdal_array: {gdal_array.__file__}')
EOF

RUN apt-get update -qq && apt-get install -y --no-install-recommends python3.12-venv libhiredis-dev

# ── Build tools for source-built extensions ─────────────────────────────────
# scikit-build-core / pybind11 are for tappa (GitHub-only, no PyPI release,
# built against system GDAL/PROJ/GEOS). Installed early so every later
# --no-build-isolation install can find them.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install \
        --python /opt/gdal-py/bin/python \
        "scikit-build-core" "pybind11>=2.12" \
 && find /opt/gdal-py -type d -name __pycache__ -exec rm -rf {} +


# -- pyarrow: link system Arrow C++ (one libarrow per process) ----------------
# Flags mirror what the Apache apt packages actually install (see
# ArrowOptions.cmake plus ls of the libdir): core, compute, dataset, acero,
# parquet, plus ORC/S3/GCS/Azure/HDFS which are compiled into libarrow.so.
# Flight, Gandiva, CUDA, Substrait are separate debs that are not installed.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --python /opt/gdal-py/bin/python \
        cython "cmake>=3.25" ninja setuptools setuptools_scm \
 && ARROW_HOME=/usr \
    PYARROW_BUNDLE_ARROW_CPP=0 \
    PYARROW_PARALLEL=$(nproc) \
    PYARROW_WITH_PARQUET=1 \
    PYARROW_WITH_PARQUET_ENCRYPTION=1 \
    PYARROW_WITH_DATASET=1 \
    PYARROW_WITH_ACERO=1 \
    PYARROW_WITH_ORC=1 \
    PYARROW_WITH_S3=1 \
    PYARROW_WITH_GCS=1 \
    PYARROW_WITH_AZURE=1 \
    PYARROW_WITH_HDFS=1 \
    PYARROW_WITH_FLIGHT=0 \
    PYARROW_WITH_GANDIVA=0 \
    PYARROW_WITH_SUBSTRAIT=0 \
    PYARROW_WITH_CUDA=0 \
    uv pip install --python /opt/gdal-py/bin/python \
        --no-build-isolation \
        --no-binary pyarrow \
        --constraint /opt/pyarrow-constraint.txt \
        pyarrow \
 && find /opt/gdal-py -type d -name __pycache__ -exec rm -rf {} +


# ── Source-built: link system GDAL/PROJ/GEOS ──────────────────────────────────
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    GDAL_CONFIG=/usr/local/bin/gdal-config \
    PROJ_DIR=/usr/local \
    uv pip install \
        --python /opt/gdal-py/bin/python \
        --no-binary rasterio,fiona,pyogrio,shapely,pyproj,geopandas,odc-geo,rioxarray \
        pyproj shapely fiona rasterio pyogrio geopandas odc-geo rioxarray \
 && find /opt/gdal-py -type d -name __pycache__ -exec rm -rf {} +

ENV DASK_ARRAY__QUERY_PLANNING=True

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --python /opt/gdal-py/bin/python \
        setuptools wheel numpy imagecodecs \
 && uv pip install --python /opt/gdal-py/bin/python \
        --no-build-isolation-package imagecodecs-numcodecs \
        --constraint /opt/pyarrow-constraint.txt \
        --no-binary pyarrow \
        build \
        pandas xarray scipy matplotlib cftime pytz tzdata \
        zarr netCDF4 h5netcdf h5py \
        fsspec aiohttp requests s3fs \
        kerchunk virtualizarr rechunker \
        tifffile imagecodecs async-tiff \
        fastparquet \
        polars "ibis-framework[duckdb]" \
        stac-geoparquet geoarrow-pyarrow \
        cloudpickle toolz partd \
        pystac-client stackstac rio-stac \
        earthaccess pooch \
        icechunk obstore virtual-tiff arraylake \
        cython \
        affine attrs click cligj snuggs pyparsing click-plugins \
        jupyterlab jupyterhub jupyter-rsession-proxy \
        ipytree lonboard pyresample \
        'marimo[sandbox]>=0.23.4' \
        marimo-jupyter-extension \
        rasterix \
        git+https://github.com/hypertidy/gdalxarray@main \
        coiled \
        frisky  \
        dask-array \
        sedona sedonadb sedonadb_zarr \
        pytest \
        git+https://github.com/dask/dask@6c8edcef067fa5f04adcd398e0de0b20b74c7abb  \
        git+https://github.com/pydata/xarray@71cfb13ac7e05a8d37f63291436fa90820af9304 \
 && find /opt/gdal-py -type d -name __pycache__ -exec rm -rf {} + \
 && find /opt/gdal-py -type f -name "*.pyc" -delete

# ── reticulate: pin to the venv ──────────────────────────────────────────────
# RETICULATE_PYTHON forces reticulate down the "use this interpreter" branch
# and short-circuits the uv-managed-venv logic that py_require() would
# otherwise trigger. RETICULATE_USE_MANAGED_VENV=no is belt-and-braces against
# future reticulate versions changing discovery precedence.
RUN R -q -e 'install.packages("reticulate", repos = "https://cloud.r-project.org")'
ENV RETICULATE_PYTHON=/opt/gdal-py/bin/python
ENV RETICULATE_USE_MANAGED_VENV=no

# -- rust-for-pizzarr: should be ok with icechunk on wheels above ------
ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path \
 && rustc --version && cargo --version

RUN --mount=type=cache,target=/opt/cargo/registry \
    --mount=type=cache,target=/opt/cargo/git \
    NOT_CRAN=true PIZZARR_FEATURES=s3,gcs \
    R -e 'install.packages("pizzarr", \
            repos = c("https://zarr-developers.r-universe.dev", "https://cloud.r-project.org"), \
            type = "source")'

# Optional: fail the build if the toolchain ever drifts below 1.91
RUN rustc --version \
    | awk '{ split($2, a, "."); if (a[1]*100 + a[2] < 191) exit 1 }'


# ── Verify Python stack alignment ────────────────────────────────────────────
COPY scripts/check-python-versions.py /opt/scripts/check-python-versions.py
RUN if [ "${IMAGE_VARIANT}" = "release" ]; then \
        python /opt/scripts/check-python-versions.py; \
    else \
        python /opt/scripts/check-python-versions.py \
            || echo "WARNING: python alignment check failed on dev variant"; \
    fi

# GDAL first, then pyarrow (the reticulate / gdalxarray order)
RUN <<'EOF' /opt/gdal-py/bin/python
import re, subprocess, pathlib
from osgeo import gdal
import pyarrow as pa
import pyarrow.parquet, pyarrow.dataset

cpp = subprocess.check_output(["pkg-config", "--modversion", "arrow"], text=True).strip()
print(f"pyarrow {pa.__version__}  cpp {pa.cpp_version}  system {cpp}")
assert pa.cpp_version.split(".")[0] == cpp.split(".")[0], "pyarrow/libarrow major mismatch"

pkg = pathlib.Path(pa.__file__).parent
# libarrow_python*.so is pyarrow's own glue layer (Python <-> Arrow
# conversion), always built and installed alongside the extension; it links
# TO the system libarrow. Anything else under libarrow*/libparquet* would be
# a bundled copy of Arrow C++.
bundled = [p for p in list(pkg.glob("libarrow*.so*")) + list(pkg.glob("libparquet*.so*"))
           if not p.name.startswith("libarrow_python")]
assert not bundled, f"bundled Arrow C++ found: {bundled}"

ldd = subprocess.check_output(["ldd", str(pkg / "libarrow_python.so")], text=True)
print(ldd)
assert re.search(r"libarrow\.so\.\d+ => /(usr/)?lib/x86_64-linux-gnu/", ldd), \
    "libarrow_python not linked to system libarrow"

maps = open("/proc/self/maps").read()
libs = sorted({m for m in re.findall(r"\S*libarrow\.so\S*", maps)})
print("libarrow mapped:", libs)
SYSLIB = ("/usr/lib/x86_64-linux-gnu/", "/lib/x86_64-linux-gnu/")  # merged-usr
assert len(libs) == 1 and libs[0].startswith(SYSLIB), libs
EOF

# pyarrow first, then GDAL's Parquet driver
RUN <<'EOF' /opt/gdal-py/bin/python
import re
import pyarrow as pa
from osgeo import gdal, ogr
assert ogr.GetDriverByName("Parquet") is not None, "GDAL lacks Parquet driver"
libs = {m for m in re.findall(r"\S*libarrow\.so\S*", open("/proc/self/maps").read())}
assert len(libs) == 1, libs
print("ok: single libarrow with pyarrow loaded first")
EOF


# ── MOTD: refreshed for this image (file overwrite; bashrc was set in gdal-system)
RUN { \
        echo "── ghcr.io/hypertidy/gdal-r-python ──" ; \
        echo "GDAL $(gdal-config --version)   PROJ $(pkg-config --modversion proj)   GEOS $(geos-config --version)" ; \
        echo "R    $(R --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')" ; \
        echo "Py   $(/opt/gdal-py/bin/python -c 'import sys; print(sys.version.split()[0])')   numpy $(/opt/gdal-py/bin/python -c 'import numpy; print(numpy.__version__)')   pyarrow $(/opt/gdal-py/bin/python -c 'import pyarrow; print(pyarrow.__version__)') (libarrow $(pkg-config --modversion arrow))" ; \
        echo "" ; \
        echo "Docs: https://github.com/hypertidy/gdal-r-ci#gdal-r-python" ; \
    } > /etc/gdal-r-ci-motd

WORKDIR /workspace
CMD ["bash"]
